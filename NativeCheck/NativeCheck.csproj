<Project Sdk="Microsoft.NET.Sdk">
  <!-- Exercises pikmin.dll through the plugin's own Native.cs, outside the game: struct
       layouts, callbacks and arrays across P/Invoke. usage: dotnet run, then the path to pikmin.dll -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\OlimarTest\Native.cs" Link="Native.cs" />
    <Compile Include="..\OlimarTest\JumpWhistleButton.cs" Link="JumpWhistleButton.cs" />
    <!-- The view structs and native loading Native.cs uses (plain C#, no Unity). -->
    <Compile Include="..\..\ror2-common\src\ViewSource.cs" Link="Common\ViewSource.cs" />
    <Compile Include="..\..\ror2-common\src\NativeLib.cs" Link="Common\NativeLib.cs" />
  </ItemGroup>
</Project>
